{
  "name": "talibon-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @talibon/api --filter @talibon/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prisma:generate": "pnpm --filter @talibon/api prisma:generate",
    "prisma:migrate": "pnpm --filter @talibon/api prisma:migrate",
    "prisma:seed": "pnpm --filter @talibon/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "typescript-eslint": "8.44.1",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "husky": "9.1.7",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "lint-staged": "16.2.0",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
